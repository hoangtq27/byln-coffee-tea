# Chuỗi kết nối Neon PostgreSQL. Để trống khi chạy local -> dùng PGlite (PostgreSQL nhúng, lưu ở backend/.data)
DATABASE_URL=
# Bắt buộc ở production: chuỗi ngẫu nhiên dài
JWT_SECRET=
JWT_EXPIRES=12h
# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy), ví dụ URL của Vercel
CORS_ORIGIN=http://localhost:5173
PORT=4000
